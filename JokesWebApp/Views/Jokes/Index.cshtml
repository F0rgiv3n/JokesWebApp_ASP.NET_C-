@model IEnumerable<JokesWebApp.Models.Joke>  //λιστα me ta jokes gia na ta emfanisei

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.JokeQuestion)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
		@foreach (var item in Model)
		{ // gia kathe joke pou exei to model tha emfanisei ena tr me ta stoixeia tis
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.JokeQuestion)
            </td>
				                           // ta esvisa gia na emfanisei mono to question kai oxi to answer
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
